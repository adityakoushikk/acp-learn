# Copy to /etc/acplearn/acplearn.env and adjust for your server.
APP_BASE_DIR=/home/ubuntu/acp-learn
BACKEND_BIND=127.0.0.1:8000
MAX_CONTENT_LENGTH=1048576
MAX_PEPTIDES=500
MAX_SEQUENCE_LENGTH=10000
FEATURE_TIMEOUT_SECONDS=90
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=300
LOG_LEVEL=INFO

# Leave blank for the recommended same-origin Nginx setup. If another website
# calls Flask directly, list exact allowed origins separated by commas.
CORS_ORIGINS=
